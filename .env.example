# Pync Parcel Chateau — environment template.
# Copy to .env and fill in real values.  NEVER commit the real .env.

APP_ENV=production
APP_NAME="Pync Parcel Chateau"

# --- Database ---
DB_HOST=localhost
DB_USER=pyncuser
DB_PASS=
DB_NAME=pyncparcel

# --- Email (PHPMailer / SMTP) ---
# Leave USERNAME/PASSWORD blank for an unauthenticated local relay.
# Set MAIL_ENCRYPTION to tls or ssl for a real provider; blank = plain connection.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# --- Google reCAPTCHA v2 ---
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Warehouse API (optional; requires php-curl) ---
WAREHOUSE_API_URL=
WAREHOUSE_API_KEY=

# --- Post-signup redirect (optional) ---
SIGNUP_REDIRECT_URL_PROD=
SIGNUP_REDIRECT_URL_DEV=
